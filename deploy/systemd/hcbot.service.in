# HEALTH Discord bot (Go) — system service for the instance @NAME@.
#
# Template: make builds build/<name>.service from this file (see
# README.md, "Run as a systemd service"). Do not edit build/ by hand.
#   make instance NAME=@NAME@ && sudo make install-instance NAME=@NAME@
#   sudo systemctl enable --now @NAME@
# Logs:
#   journalctl -u @NAME@ -f

[Unit]
Description=HEALTH Discord bot (@NAME@)
Documentation=file://@RUNDIR@/README.md
Wants=network-online.target
After=network-online.target
# Stop trying after 5 crashes in 5 minutes (for example, a bad token).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Group=@GROUP@
# .env, hcbot.db, markov.db, backups/ and README.md are in this
# folder. Each instance has its own folder; all use the same binary.
WorkingDirectory=@RUNDIR@
ExecStart=@BINDIR@/hcbot
Restart=on-failure
RestartSec=10s
# The bot stops cleanly on SIGTERM: it closes the gateway and the database.
KillSignal=SIGTERM
TimeoutStopSec=30s

# Logging: everything goes to the journal. The bot leaves out its own
# timestamps when it runs under systemd.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=@NAME@

# New files (database, backups) are private to the @USER@ user.
UMask=0077

# Security: the bot only needs the network and its own folder.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@RUNDIR@
# ProtectHome=yes, or for a folder in /home, lines that show the bot only
# its own folder there (see README.md, "A folder in /home").
@PROTECTHOME@
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
